#!/bin/bash

# AWS credentials (from AWS IAM).
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_SESSION_TOKEN=
export AWS_DEFAULT_REGION=us-east-1

# Name of the EC2 key pair.
export AWS_KEYPAIR_NAME=

# Path to the private key file on your local machine.
export AWS_EC2_SSH_KEYPAR_PATH=
# Security group ID.
export AWS_SECURITY_GROUP=

# Directory of this scripts folder (do not change).
export DIR=$(dirname "$(realpath "$0")")
